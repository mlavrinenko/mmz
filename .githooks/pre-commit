#!/usr/bin/env bash
set -eo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root"

# outdatty.lock records the coupled sources' hashes. A commit whose sources
# moved while the lock stayed behind leaves the committed tree stale, and the
# mmz check below cannot see it: that check reads the worktree, where the
# updated lock is present even when unstaged. Refuse the commit until the lock
# is either staged with the change it records or restored.
if ! git diff --quiet -- outdatty.lock; then
  echo "pre-commit: outdatty.lock has unstaged changes" >&2
  echo "pre-commit: stage it with the change it records (git add outdatty.lock) or restore it" >&2
  exit 1
fi

# `mmz --is-fresh --tag gate` asserts every gate-tagged rule in .mmz/ already
# passed against this worktree, running nothing of its own, so it is cheap
# enough for every commit. mmz is the crate under development, not a dev-shell
# tool: the binary is the one `just check` built, the same one the close gate
# in .mindtape/config.toml runs. No binary means no pass was ever recorded.
mmz=target/debug/mmz
if [ ! -x "$mmz" ]; then
  echo "pre-commit: no $mmz yet; run \`just check\` to build it and record a pass" >&2
  exit 1
fi

# The rules' probes run `just`, `jq` and `git`, and their digests must match
# the ones `just check` recorded inside the dev shell. Skip entering it only
# when direnv already loaded it for this checkout; otherwise enter it the
# cheapest way available.
if [ "${DIRENV_DIR#-}" = "$root" ]; then
  exec "$mmz" --is-fresh --tag gate
elif command -v direnv >/dev/null 2>&1 && direnv exec "$root" true 2>/dev/null; then
  exec direnv exec "$root" "$mmz" --is-fresh --tag gate
fi
exec nix develop "$root" --command "$mmz" --is-fresh --tag gate
